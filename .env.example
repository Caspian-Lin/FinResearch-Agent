# =============================================================================
# FinResearch Agent — Environment Variables (Example)
# Copy this file to `.env` and adjust values for your local environment.
# `.env` is git-ignored — never commit real secrets.
#
# Defaults below target LOCAL DEV (no Docker): hosts point at localhost. If you
# run the stack under Docker Compose, set POSTGRES_HOST=postgres and
# REDIS_HOST=redis (the Compose service names).
# =============================================================================

# ---------- PostgreSQL + TimescaleDB ----------
POSTGRES_USER=finresearch
POSTGRES_PASSWORD=finresearch_dev_password
POSTGRES_DB=finresearch
# Local dev: localhost. Docker Compose: postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy DSN used by API, worker, and Alembic
DATABASE_URL=postgresql+psycopg://finresearch:finresearch_dev_password@localhost:5432/finresearch

# ---------- Redis ----------
# Local dev: localhost. Docker Compose: redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ---------- FastAPI ----------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Auth (initial admin) ----------
INITIAL_ADMIN_EMAIL=admin@finresearch.local
INITIAL_ADMIN_PASSWORD=admin_password_change_me

# ---------- Frontend (web) ----------
VITE_API_BASE_URL=http://localhost:8000

# ---------- Data sources ----------
# yfinance is anonymous; add tokens here if you integrate paid sources
YFINANCE_USER_AGENT=FinResearch-Agent/0.1
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=

# Domestic A-share sources (FRA-23). AkShare needs no token. Tushare Pro
# requires a registered token from https://tushare.pro; leave blank to disable
# the tushare source. (Install the libs with: uv sync --extra data-cn)
TUSHARE_TOKEN=

# ---------- LLM / Agent ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=60

# Planner provider: "fixture" (default, offline regex) or "openai" (LLM via httpx).
# Users can override this per-account via the Settings page (FRA-93).
PLANNER_PROVIDER=fixture
PLANNER_MAX_REPAIRS=2
PLANNER_TEMPERATURE=0.0

# Secret key for encrypting per-user API keys (FRA-93). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a derived key is used (dev only — set explicitly in production).
SECRET_KEY=

# ---------- Worker ----------
RQ_QUEUE_DEFAULT=default
RQ_QUEUE_DATA=data_sync
RQ_QUEUE_BACKTEST=backtest

# ---------- Sentiment / News (FRA-67) ----------
# Provider key: "fixture" ships sample data (no network, reproducible demo/tests);
# "yfinance" fetches real headlines via yfinance.Ticker(symbol).news.
NEWS_PROVIDER=fixture
NEWS_FETCH_TIMEOUT_SECONDS=30
NEWS_MAX_ITEMS_PER_ASSET=100
# Preflight rejects windows larger than this (days) to guard volatile text sources.
NEWS_SYNC_MAX_WINDOW_DAYS=30

# ---------- Sentiment classifier (FRA-68) ----------
# Classifier key: "fixture" = deterministic keyword rule (no LLM, reproducible
# tests/demo); "openai" = OpenAI-compatible chat completions via httpx (needs
# OPENAI_API_KEY). Default fixture so local dev/tests never call an LLM.
SENTIMENT_CLASSIFIER=fixture
SENTIMENT_TEMPERATURE=0.0
SENTIMENT_CLASSIFY_BATCH_SIZE=10
SENTIMENT_CLASSIFY_MAX_ITEMS=200

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json
